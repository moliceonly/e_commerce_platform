# 本地开发示例。复制为 config.local.yaml 后按需改（config.local.yaml 已 gitignore）。
# 启动：APP_ENV=local；实现 LoadYAML 后由 viper 读取本文件，环境变量可覆盖同名字段。

app_env: local
http_addr: ":8080"
mysql_dsn: "trainer:Train2026Lib!@tcp(127.0.0.1:3306)/training_lib?charset=utf8mb4&parseTime=True&loc=Local"
redis_addr: "127.0.0.1:6379"
jwt_secret: "dev-secret-change-me"

